{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hospital-workspace.example.internal/schemas/evidence-manifest.v3.json",
  "title": "Hospital Workspace Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "program", "scope", "risk", "acceptanceTier", "sourceBinding", "resultBinding", "resultCommit", "branch", "environments", "requiredCheckIds", "checks", "ciArtifacts", "negativeScenarios", "rollback", "recovery", "rehearsalRequirements", "requiredReviewAgents", "reviewReceipts", "privacyCategories", "dataClassification", "limitations", "decision", "decisionOwner", "decidedAt"],
  "properties": {
    "schemaVersion": { "const": "hospital-workspace.evidence.v3" },
    "program": { "const": "hospital-workspace" },
    "scope": { "$ref": "#/$defs/scope" },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "acceptanceTier": { "enum": ["terra", "sol-acceptance", "sol-architecture-security", "sol-phase-gate"] },
    "sourceBinding": { "$ref": "#/$defs/commitBinding" },
    "resultBinding": { "$ref": "#/$defs/treeBinding" },
    "resultCommit": { "$ref": "#/$defs/sha" },
    "branch": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s~^:?*\\[\\]\\\\]+$" },
    "environments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/environment" } },
    "requiredCheckIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "ciArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "negativeScenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "rollback": { "$ref": "#/$defs/recovery" },
    "recovery": { "$ref": "#/$defs/recovery" },
    "rehearsalRequirements": { "type": "object", "additionalProperties": false, "required": ["rollback", "recovery"], "properties": { "rollback": { "type": "boolean" }, "recovery": { "type": "boolean" } } },
    "requiredReviewAgents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewRequirement" } },
    "reviewReceipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewReceipt" } },
    "privacyCategories": { "$ref": "#/$defs/privacy" },
    "dataClassification": { "const": "public-synthetic" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["PASS", "CONDITIONAL", "BLOCKED"] },
    "decisionOwner": { "enum": ["parent_codex", "human_owner"] },
    "decidedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
    "commitBinding": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "commit" }, "value": { "$ref": "#/$defs/sha" } } },
    "treeBinding": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "tree" }, "value": { "$ref": "#/$defs/tree" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["kind", "phaseId", "taskId"], "properties": { "kind": { "enum": ["task", "phase"] }, "phaseId": { "pattern": "^HW-[0-9]{2}$" }, "taskId": { "type": ["string", "null"] } }, "allOf": [{ "if": { "properties": { "kind": { "const": "task" } }, "required": ["kind"] }, "then": { "properties": { "taskId": { "type": "string", "pattern": "^HW[0-9]{2}-[0-9]{2}$" } } } }, { "if": { "properties": { "kind": { "const": "phase" } }, "required": ["kind"] }, "then": { "properties": { "taskId": { "type": "null" } } } }] },
    "reference": { "type": "string", "pattern": "^(?:ci|pr|github|parent-session|external|not-run)://[A-Za-z0-9._~:/?&=+-]+$" },
    "executedReference": { "type": "string", "pattern": "^(?:ci|pr|github|parent-session|external)://[A-Za-z0-9._~:/?&=+-]+$" },
    "environment": { "type": "object", "additionalProperties": false, "required": ["id", "required", "status", "claims", "evidenceRefs"], "properties": { "id": { "enum": ["ubuntu-ci", "windows-tauri-webview2-msi", "physical-anolis", "wsl2", "mock-integration", "real-upstream-integration"] }, "required": { "type": "boolean" }, "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] }, "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ubuntu-ci", "windows-tauri-webview2-msi", "physical-anolis", "wsl2", "mock-integration", "real-upstream-his"] } }, "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } } }, "allOf": [{ "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] }, "then": { "properties": { "evidenceRefs": { "items": { "$ref": "#/$defs/executedReference" } } } } }] },
    "check": { "type": "object", "additionalProperties": false, "required": ["id", "required", "environment", "status", "evidenceRef"], "properties": { "id": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "environment": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] }, "evidenceRef": { "$ref": "#/$defs/reference" } }, "allOf": [{ "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] }, "then": { "properties": { "evidenceRef": { "$ref": "#/$defs/executedReference" } } } }] },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["name", "reference", "binding"], "properties": { "name": { "type": "string", "minLength": 1 }, "reference": { "$ref": "#/$defs/reference" }, "binding": { "$ref": "#/$defs/treeBinding" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "status", "evidenceRef"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] }, "evidenceRef": { "$ref": "#/$defs/reference" } }, "allOf": [{ "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] }, "then": { "properties": { "evidenceRef": { "$ref": "#/$defs/executedReference" } } } }] },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["status", "reference", "rationale", "applicabilityBoundary", "reviewerConfirmation"], "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "NOT_APPLICABLE"] }, "reference": { "$ref": "#/$defs/reference" }, "rationale": { "type": "string" }, "applicabilityBoundary": { "type": "string" }, "reviewerConfirmation": { "type": "string" } }, "allOf": [{ "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } }, "required": ["status"] }, "then": { "properties": { "rationale": { "minLength": 1 }, "applicabilityBoundary": { "minLength": 1 }, "reviewerConfirmation": { "minLength": 1 } } } }, { "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] }, "then": { "properties": { "reference": { "$ref": "#/$defs/executedReference" } } } }] },
    "reviewRequirement": { "type": "object", "additionalProperties": false, "required": ["agent", "outcome"], "properties": { "agent": { "enum": ["terra_reviewer", "terra_security", "sol_acceptance", "sol_architecture_security", "sol_phase_gate"] }, "outcome": { "enum": ["APPROVED", "ACCEPT", "PASS_RECOMMENDED"] } } },
    "reviewReceipt": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "reviewerRole", "agent", "model", "reviewType", "sourceCommit", "resultCommit", "resultTree", "reviewedDiffBase", "reviewedDiffHead", "outcome", "limitations", "reference"], "properties": { "schemaVersion": { "const": "hospital-workspace.review-receipt.v1" }, "reviewerRole": { "type": "string", "minLength": 1 }, "agent": { "enum": ["terra_reviewer", "terra_security", "sol_acceptance", "sol_architecture_security", "sol_phase_gate"] }, "model": { "type": "string", "minLength": 1 }, "reviewType": { "enum": ["implementation", "security", "acceptance", "architecture-security", "phase-gate"] }, "sourceCommit": { "$ref": "#/$defs/sha" }, "resultCommit": { "$ref": "#/$defs/sha" }, "resultTree": { "$ref": "#/$defs/tree" }, "reviewedDiffBase": { "$ref": "#/$defs/sha" }, "reviewedDiffHead": { "$ref": "#/$defs/sha" }, "outcome": { "enum": ["APPROVED", "ACCEPT", "PASS_RECOMMENDED"] }, "limitations": { "type": "array", "items": { "type": "string" } }, "reference": { "$ref": "#/$defs/executedReference" } } },
    "privacy": { "type": "object", "additionalProperties": false, "required": ["patientData", "employeePersonData", "identityNumbers", "diagnosisClinicalText", "phone", "email", "detailedFee", "cookie", "token", "password", "apiKeyClientSecret", "privateKeySigningMaterial", "internalHostnameNetwork", "clinicalPromptContent"], "properties": { "patientData": { "const": "CLEAR" }, "employeePersonData": { "const": "CLEAR" }, "identityNumbers": { "const": "CLEAR" }, "diagnosisClinicalText": { "const": "CLEAR" }, "phone": { "const": "CLEAR" }, "email": { "const": "CLEAR" }, "detailedFee": { "const": "CLEAR" }, "cookie": { "const": "CLEAR" }, "token": { "const": "CLEAR" }, "password": { "const": "CLEAR" }, "apiKeyClientSecret": { "const": "CLEAR" }, "privateKeySigningMaterial": { "const": "CLEAR" }, "internalHostnameNetwork": { "const": "CLEAR" }, "clinicalPromptContent": { "const": "CLEAR" } } }
  },
  "allOf": [
    { "if": { "properties": { "decision": { "const": "PASS" } }, "required": ["decision"] }, "then": { "properties": { "environments": { "not": { "contains": { "properties": { "required": { "const": true }, "status": { "not": { "const": "PASS" } } }, "required": ["required", "status"] } } }, "checks": { "not": { "contains": { "properties": { "required": { "const": true }, "status": { "not": { "const": "PASS" } } }, "required": ["required", "status"] } } }, "negativeScenarios": { "not": { "contains": { "properties": { "status": { "not": { "const": "PASS" } } }, "required": ["status"] } } }, "ciArtifacts": { "items": { "properties": { "reference": { "$ref": "#/$defs/executedReference" } } } } } } },
    { "if": { "properties": { "decision": { "const": "PASS" }, "risk": { "enum": ["high", "critical"] } }, "required": ["decision", "risk"] }, "then": { "properties": { "rollback": { "properties": { "status": { "enum": ["PASS", "NOT_APPLICABLE"] } } }, "recovery": { "properties": { "status": { "enum": ["PASS", "NOT_APPLICABLE"] } } } } } },
    { "if": { "properties": { "rehearsalRequirements": { "properties": { "rollback": { "const": true } }, "required": ["rollback"] } }, "required": ["rehearsalRequirements"] }, "then": { "properties": { "rollback": { "properties": { "status": { "not": { "const": "NOT_APPLICABLE" } } } } } } },
    { "if": { "properties": { "rehearsalRequirements": { "properties": { "recovery": { "const": true } }, "required": ["recovery"] } }, "required": ["rehearsalRequirements"] }, "then": { "properties": { "recovery": { "properties": { "status": { "not": { "const": "NOT_APPLICABLE" } } } } } } }
  ]
}
